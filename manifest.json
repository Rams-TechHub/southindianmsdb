const { addonBuilder } = require("stremio-addon-sdk");

// 1. Master database of real South Indian Movies with TMDB IDs
const manualLists = {
    "malayalam_classics": [
        { id: "tmdb:13854728", name: "Minnal Murali (2021)", type: "movie", poster: "https://tmdb.org", description: "Superhero" },
        { id: "tmdb:1151608", name: "Manjummel Boys (2024)", type: "movie", poster: "https://tmdb.org", description: "Survival Drama" },
        { id: "tmdb:1214319", name: "Aavesham (2024)", type: "movie", poster: "https://tmdb.org", description: "Action Comedy" },
        { id: "tmdb:1214436", name: "Bramayugam (2024)", type: "movie", poster: "https://tmdb.org", description: "Period Horror Thriller" },
        { id: "tmdb:255953", name: "Drishyam (2013)", type: "movie", poster: "https://tmdb.org", description: "Cult Mystery Thriller" }
    ],
    "tamil_classics": [
        { id: "tmdb:21334812", name: "Leo (2023)", type: "movie", poster: "https://tmdb.org", description: "Action Thriller" },
        { id: "tmdb:836010", name: "Vikram (2022)", type: "movie", poster: "https://tmdb.org", description: "High-Octane Action" },
        { id: "tmdb:1033230", name: "Jailer (2023)", type: "movie", poster: "https://tmdb.org", description: "Action Comedy Drama" }
    ],
    "telugu_classics": [
        { id: "tmdb:11658274", name: "RRR (2022)", type: "movie", poster: "https://tmdb.org", description: "Action Epic" },
        { id: "tmdb:293299", name: "Baahubali: The Beginning (2015)", type: "movie", poster: "https://tmdb.org", description: "Fantasy Epic" },
        { id: "tmdb:695721", name: "Pushpa: The Rise (2021)", type: "movie", poster: "https://tmdb.org", description: "Action Crime" }
    ],
    "kannada_classics": [
        { id: "tmdb:505191", name: "K.G.F: Chapter 1 (2018)", type: "movie", poster: "https://tmdb.org", description: "Period Action Epic" },
        { id: "tmdb:916605", name: "Kantara (2022)", type: "movie", poster: "https://tmdb.org", description: "Action Thriller Folktale" },
        { id: "tmdb:812225", name: "777 Charlie (2022)", type: "movie", poster: "https://tmdb.org", description: "Adventure Drama" }
    ]
};

// 2. Addon Configuration Manifest
const builder = new addonBuilder({
    id: "org.southindiancinema.addon",
    version: "1.4.0",
    name: "South Indian Cinema Hub",
    description: "Curated catalogs for Telugu, Tamil, Malayalam, and Kannada cinema.",
    resources: ["catalog", "meta", "stream"],
    types: ["movie"],
    catalogs: [
        { type: "movie", id: "malayalam_classics", name: "🏆 Malayalam Cult Classics" },
        { type: "movie", id: "tamil_classics", name: "⚡ Tamil Blockbusters" },
        { type: "movie", id: "telugu_classics", name: "🔥 Tollywood Mass Epics" },
        { type: "movie", id: "kannada_classics", name: "💥 Sandalwood Masterpieces" }
    ]
});

// 3. Catalog Routing Engine
builder.defineCatalogHandler((args) => {
    const list = manualLists[args.id];
    if (list) {
        return Promise.resolve({ metas: list });
    }
    return Promise.resolve({ metas: [] });
});

// 4. Meta Details Resolver
builder.defineMetaHandler((args) => {
    for (const key in manualLists) {
        const found = manualLists[key].find(m => m.id === args.id);
        if (found) {
            return Promise.resolve({
                meta: {
                    id: found.id,
                    type: "movie",
                    name: found.name,
                    poster: found.poster,
                    description: `${found.description} - Handpicked South Indian Classic.`
                }
            });
        }
    }
    return Promise.resolve({ meta: {} });
});

// 5. Stream Handler (Uses public trailers/video formats)
builder.defineStreamHandler((args) => {
    return Promise.resolve({
        streams: [
            {
                title: "South Hub Multi-Audio Playback | 1080p",
                url: "https://googleapis.com"
            }
        ]
    });
});

// 6. Vercel Serverless Server Engine
const addonInterface = builder.getInterface();

module.exports = async (req, res) => {
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Access-Control-Allow-Headers", "*");
    res.setHeader("Content-Type", "application/json");

    const cleanPath = req.url.replace("/api/manifest", "");
    
    addonInterface.handle(cleanPath, (err, response) => {
        if (err) {
            res.status(500).end(JSON.stringify(err));
        } else {
            res.status(200).end(JSON.stringify(response));
        }
    });
};
